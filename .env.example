# RestockRadar environment variables (copy to .env and fill in real values).
#
# These are the Discord webhook URLs that config/config.yaml references BY NAME only
# (via each destination's `webhook_env_var`). The webhook URL itself is never stored in
# the YAML or the database — it is read from the environment at run time (Req 18.2). The
# names below (RR_WEBHOOK_POKEMON, RR_WEBHOOK_ADMIN) must match the `webhook_env_var`
# values in config/config.yaml.
#
# Replace the placeholder values with your real Discord webhook URLs. Do NOT commit .env.

# Product-alert destination (the `pokemon-alerts` destination in config.yaml).
RR_WEBHOOK_POKEMON=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME

# Admin / operational-warning destination (the `admin-alerts` destination in config.yaml).
RR_WEBHOOK_ADMIN=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME

# Optional overrides (uncomment to change the defaults):
# Path to the SQLite database file (default: data/restockradar.db).
#RR_DB_PATH=data/restockradar.db
# Path to the YAML configuration file (default: config/config.yaml).
#RR_CONFIG_PATH=config/config.yaml
